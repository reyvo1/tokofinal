  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@toko360.local\",\n  \"password\": \"Admin123!\"\n}"
        },
        "url": "{{apiUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('token', data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Daftar Produk",
      "request": {
        "method": "GET",
        "url": "{{apiUrl}}/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data[0]) pm.collectionVariables.set('productId', data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Daftar Gudang",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{apiUrl}}/inventory/warehouses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data[0]) pm.collectionVariables.set('warehouseId', data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Daftar Supplier",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{apiUrl}}/suppliers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data[0]) pm.collectionVariables.set('supplierId', data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Buat Purchase Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"items\": [{\n    \"productId\": \"{{productId}}\",\n    \"orderedQty\": 10,\n    \"unitCost\": 35000\n  }]\n}"
        },
        "url": "{{apiUrl}}/purchase-orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('purchaseOrderId', data.id);",
              "if (data.items[0]) pm.collectionVariables.set('purchaseOrderItemId', data.items[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Terima Barang Supplier",
      "request": {
        "method": "POST",
        "header": [
