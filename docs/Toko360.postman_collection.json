        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Pelanggan Demo\",\n  \"customerEmail\": \"pelanggan@example.com\",\n  \"address\": \"Alamat pelanggan\",\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1 }]\n}"
        },
        "url": "{{apiUrl}}/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('orderNumber', data.number);"
            ]
          }
        }
