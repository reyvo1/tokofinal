            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"purchaseOrderId\": \"{{purchaseOrderId}}\",\n  \"supplierInvoice\": \"INV-DEMO-001\",\n  \"deliveryNote\": \"SJ-DEMO-001\",\n  \"items\": [{\n    \"purchaseOrderItemId\": \"{{purchaseOrderItemId}}\",\n    \"quantityReceived\": 10,\n    \"quantityDamaged\": 1\n  }]\n}"
        },
