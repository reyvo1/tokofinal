          "mode": "raw",
          "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"paymentMethod\": \"CASH\",\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1 }]\n}"
        },
        "url": "{{apiUrl}}/sales"
      }
