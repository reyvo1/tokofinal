generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


/// Stores mutation receipts so retries cannot duplicate transactions.
model IdempotencyReceipt {
  id           String   @id @default(uuid())
  companyId    String
  scope        String
  key          String
  requestHash  String
  status       String   @default("PROCESSING")
  resourceType String?
  resourceId   String?
  response     Json?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([companyId, scope, key])
  @@index([status, createdAt])
  @@index([expiresAt])
}

/// Incremental aggregate used by dashboards and long-range reports.
model DailySalesSummary {
  id               String   @id @default(uuid())
  companyId        String
  branchId         String
  businessDate     DateTime
  channel          String
  transactionCount Int      @default(0)
  itemQuantity     Int      @default(0)
  grossSales       Decimal @default(0)
  discount         Decimal @default(0)
  tax              Decimal @default(0)
  netSales         Decimal @default(0)
  cogs             Decimal @default(0)
  grossProfit      Decimal @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([branchId, businessDate, channel])
  @@index([companyId, businessDate])
  @@index([businessDate, branchId])
}

/// Daily account totals. It can be rebuilt from journal lines.
model DailyFinanceSummary {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String
  businessDate DateTime
  accountId    String
  debit        Decimal @default(0)
  credit       Decimal @default(0)
  balance      Decimal @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([branchId, businessDate, accountId])
  @@index([companyId, businessDate])
  @@index([accountId, businessDate])
}

/// Point-in-time daily inventory aggregate for dashboards and trend reports.
model DailyInventorySummary {
  id             String   @id @default(uuid())
  companyId      String
  warehouseId    String
  businessDate   DateTime
  skuCount       Int      @default(0)
  quantity       Int      @default(0)
  reserved       Int      @default(0)
  available      Int      @default(0)
  lowStockCount  Int      @default(0)
  inventoryValue Decimal @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([warehouseId, businessDate])
  @@index([companyId, businessDate])
  @@index([businessDate, warehouseId])
}

/// Large exports and reports run asynchronously and stream output to storage.
model ReportJob {
  id            String   @id @default(uuid())
  companyId     String
  branchId      String?
  requestedById String?
  scheduleId    String?
  scheduledFor  DateTime?
  reportType    String
  format        String   @default("CSV")
  filters       Json?
  status        String   @default("PENDING")
  progress      Int      @default(0)
  outputUrl     String?
  errorMessage  String?
  expiresAt     DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  schedule      ReportSchedule? @relation(fields: [scheduleId], references: [id])
  @@unique([scheduleId, scheduledFor])
  @@index([companyId, status, createdAt])
  @@index([status, createdAt])
  @@index([scheduleId, createdAt])
}

/// First-class scheduled report definition. Worker materializes due schedules into ReportJob.
model ReportSchedule {
  id            String   @id @default(uuid())
  companyId     String
  branchId      String
  requestedById String?
  name          String
  reportType    String
  format        String   @default("CSV")
  filters       Json?
  frequency     String
  localTime     String
  dayOfWeek     Int?
  dayOfMonth    Int?
  timezone      String
  isActive      Boolean  @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  lastJobId     String?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  jobs          ReportJob[]
  @@unique([companyId, branchId, name])
  @@index([isActive, nextRunAt])
  @@index([companyId, branchId, isActive])
}

model DataRetentionPolicy {
  id           String   @id @default(uuid())
  companyId    String
  entityType   String
  hotDays      Int      @default(365)
  warmDays     Int      @default(1095)
  archiveAfter Boolean  @default(true)
  deleteAfterDays Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([companyId, entityType])
}

model DataArchiveRun {
  id            String   @id @default(uuid())
  companyId     String
  entityType    String
  rangeStart    DateTime
  rangeEnd      DateTime
  status        String   @default("PENDING")
  rowsProcessed Int      @default(0)
  archiveUri    String?
  checksum      String?
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([companyId, entityType, createdAt])
  @@index([status, createdAt])
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE
  ONLINE_ORDER
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  LOCATION_MOVE_IN
  LOCATION_MOVE_OUT
  PRODUCTION_CONSUME
  PRODUCTION_OUTPUT
}

enum InventoryCondition {
  AVAILABLE
  DAMAGED
  QUARANTINE
  LOST
}

enum ProductionOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DigitalServiceTransactionStatus {
  QUEUED
  PROCESSING
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum SaleChannel {
  POS
  ONLINE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKED
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String?  @unique
  timezone  String   @default("Asia/Makassar")
  currency  String   @default("IDR")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  products  Product[]
  suppliers Supplier[]
  masterReferences MasterReference[]
  customers Customer[]
  categories Category[]
  purchaseRequests PurchaseRequest[]
  orderReturns OrderReturn[]
  productionRecipes ProductionRecipe[]
  productionOrders ProductionOrder[]
  digitalServiceProducts DigitalServiceProduct[]
  digitalServiceTransactions DigitalServiceTransaction[]
  staffMemos StaffMemo[]
}

model Branch {
  id         String      @id @default(uuid())
  companyId  String
  code       String      @unique
  name       String
  address    String?
  isActive   Boolean     @default(true)
  metadata   Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]
  users      User[]
  sales      Sale[]
  orders     Order[]
  accounts   Account[]
  masterReferences MasterReference[]
  productPrices ProductPrice[]
  purchaseRequests PurchaseRequest[]
  orderReturns OrderReturn[]
  productionOrders ProductionOrder[]
  digitalServiceTransactions DigitalServiceTransaction[]
  staffMemos StaffMemo[]
}

model Warehouse {
  id             String              @id @default(uuid())
  branchId       String
  code           String              @unique
  name           String
  address        String?
  isDefault      Boolean             @default(false)
  isActive       Boolean             @default(true)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  branch         Branch              @relation(fields: [branchId], references: [id])
  inventories    Inventory[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  movements      InventoryMovement[]
  sales          Sale[]
  orders         Order[]
  purchaseRequests PurchaseRequest[]
  orderReturns OrderReturn[]
  productionOrders ProductionOrder[]
  @@index([branchId])
}

model User {
  id           String       @id @default(uuid())
  branchId     String?
  name         String
  email        String       @unique
  passwordHash                 String
  twoFactorEnabled             Boolean      @default(false)
  twoFactorSecretEncrypted     String?
  twoFactorPendingSecretEncrypted String?
  twoFactorRecoveryCodes       Json?
  // Supervisor override PIN. Nullable on purpose: a user without one simply cannot approve a
  // privileged action, and the POS must say so rather than falling back to "no PIN needed".
  supervisorPinHash             String?
  // Managers may approve on behalf of the branch. A cashier never can, whatever their PIN.
  canApprovePrivilegedActions   Boolean      @default(false)
  supervisorPinUpdatedAt        DateTime?
  isActive                     Boolean      @default(true)
  createdAt                    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  branch       Branch?      @relation(fields: [branchId], references: [id])
  roles        UserRole[]
  auditLogs    AuditLog[]
  cashierShifts CashierShift[]
  sessions       AuthSession[]
  passwordResetTokens PasswordResetToken[]
  createdProductionOrders ProductionOrder[]
  requestedDigitalServiceTransactions DigitalServiceTransaction[]
  staffMemos StaffMemo[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  activeBranchId   String?
  expiresAt        DateTime
  refreshTokenHash String?  @unique
  lastRotatedAt    DateTime?
  lastSeenAt       DateTime @default(now())
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt, expiresAt])
  @@index([activeBranchId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model RateLimitBucket {
  id           String   @id @default(uuid())
  scope        String
  keyHash      String
  windowStart  DateTime
  count        Int      @default(0)
  blockedUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@index([updatedAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Category {
  id        String     @id @default(uuid())
  companyId String?
  parentId  String?
  name      String
  slug      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company?   @relation(fields: [companyId], references: [id])
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  @@unique([companyId, slug])
  @@index([companyId, parentId, isActive, sortOrder, name])
}

model Product {
  id                 String                @id @default(uuid())
  companyId          String?
  categoryId         String?
  brandCode          String?
  sku                String                @unique
  barcode            String?               @unique
  name               String
  description        String?
  unit               String
  costPrice          Decimal
  salePrice          Decimal
  retailCeilingPrice Decimal?
  minStock           Int                   @default(0)
  productType       String                @default("PHYSICAL")
  taxCategoryCode   String?
  salesTaxCodeId    String?
  purchaseTaxCodeId String?
  trackBatch        Boolean               @default(false)
  trackExpiry       Boolean               @default(false)
  trackSerial       Boolean               @default(false)
  allowNegativeStock Boolean              @default(false)
  metadata          Json?
  isActive           Boolean               @default(true)
  // POST-1D. A kiosk shows availability only when the product opts in. Default false, because
  // "stok habis" on a screen the customer can see is a claim about the whole chain, and a chain
  // shows what is on the shelf — not what is in the back room or reserved for someone else.
  allowCustomerStockVisibility Boolean        @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  company            Company?              @relation(fields: [companyId], references: [id])
  category           Category?             @relation(fields: [categoryId], references: [id])
  inventories        Inventory[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  saleItems          SaleItem[]
  orderItems         OrderItem[]
  variants           ProductVariant[]
  units              ProductUnit[]
  barcodes           ProductBarcode[]
  prices             ProductPrice[]
  purchaseRequestItems PurchaseRequestItem[]
  favorites          ProductFavorite[]
  reviews            ProductReview[]
  orderReturnItems   OrderReturnItem[]
  productionOutputs  ProductionRecipe[] @relation("ProductionRecipeOutput")
  recipeComponents   ProductionRecipeItem[] @relation("ProductionRecipeComponent")
  productionOrderComponents ProductionOrderComponent[] @relation("ProductionOrderComponentProduct")
  @@index([companyId, isActive, name, id])
  @@index([companyId, sku])
  @@index([isActive, name, id])
  @@index([createdAt, id])
}

model ProductionRecipe {
  id              String   @id @default(uuid())
  companyId       String
  code            String
  name            String
  outputProductId String
  outputQtyPerBatch Int
  version         Int      @default(1)
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id])
  outputProduct   Product  @relation("ProductionRecipeOutput", fields: [outputProductId], references: [id])
  items           ProductionRecipeItem[]
  orders          ProductionOrder[]
  @@unique([companyId, code, version])
  @@index([companyId, isActive, name])
  @@index([outputProductId])
}

model ProductionRecipeItem {
  id                 String   @id @default(uuid())
  recipeId           String
  componentProductId String
  quantityPerBatch   Int
  wastePct           Decimal  @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  recipe             ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentProduct   Product @relation("ProductionRecipeComponent", fields: [componentProductId], references: [id])
  @@unique([recipeId, componentProductId])
  @@index([componentProductId])
}

model ProductionOrder {
  id               String   @id @default(uuid())
  companyId        String
  branchId         String
  warehouseId      String
  recipeId         String
  createdById      String
  number           String   @unique
  status           ProductionOrderStatus @default(DRAFT)
  batchCount       Int
  plannedOutputQty Int
  actualOutputQty  Int?
  totalCost        Decimal?
  notes            String?
  releasedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company @relation(fields: [companyId], references: [id])
  branch           Branch @relation(fields: [branchId], references: [id])
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  recipe           ProductionRecipe @relation(fields: [recipeId], references: [id])
  createdBy        User @relation(fields: [createdById], references: [id])
  components       ProductionOrderComponent[]
  @@index([companyId, branchId, status, createdAt])
  @@index([warehouseId, status])
  @@index([recipeId])
}

model ProductionOrderComponent {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  plannedQty  Int
  actualQty   Int?
  unitCost    Decimal?
  totalCost   Decimal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation("ProductionOrderComponentProduct", fields: [productId], references: [id])
  @@unique([orderId, productId])
  @@index([productId])
}

model Supplier {
  id             String          @id @default(uuid())
  companyId      String?
  code           String          @unique
  name           String
  phone          String?
  email          String?
  address        String?
  paymentTermDays Int            @default(0)
  taxIdNumber     String?
  taxProfile      Json?
  defaultTaxCodeId String?
  metadata        Json?
  isActive        Boolean        @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company?        @relation(fields: [companyId], references: [id])
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  purchaseRequests PurchaseRequest[]
  @@index([companyId, name, id])
  @@index([companyId, code])
  @@index([name, id])
  @@index([createdAt, id])
}

model Inventory {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  available   Int       @default(0)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  @@unique([warehouseId, productId])
  @@index([productId])
  @@index([warehouseId, available])
  @@index([warehouseId, updatedAt, id])
  @@index([updatedAt, id])
}

model InventoryMovement {
  id            String                @id @default(uuid())
  warehouseId   String
  productId     String
  locationId    String?
  type          InventoryMovementType
  quantity      Int
  balanceAfter  Int
  referenceType String
  referenceId   String
  notes         String?
  createdAt     DateTime              @default(now())
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  product       Product               @relation(fields: [productId], references: [id])
  @@index([warehouseId, productId, createdAt])
  @@index([locationId, productId, createdAt])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt, id])
}

model InventoryConditionBalance {
  id          String             @id @default(uuid())
  warehouseId String
  locationId  String
  productId   String
  condition   InventoryCondition
  quantity    Int                @default(0)
  updatedAt   DateTime           @updatedAt
  @@unique([locationId, productId, condition])
  @@index([warehouseId, productId, condition])
  @@index([warehouseId, locationId, condition])
}

model InventoryConditionMovement {
  id            String              @id @default(uuid())
  warehouseId   String
  locationId    String
  productId     String
  fromCondition InventoryCondition
  toCondition   InventoryCondition
  quantity      Int
  referenceType String?
  referenceId   String?
  notes         String?
  createdById   String?
  createdAt     DateTime            @default(now())
  @@index([warehouseId, productId, createdAt])
  @@index([locationId, productId, createdAt])
  @@index([referenceType, referenceId])
}

model PurchaseRequest {
  id                String   @id @default(uuid())
  number            String   @unique
  companyId         String
  branchId          String
  warehouseId       String
  supplierId        String?
  requestedById     String?
  approvedById      String?
  approvalRequestId String?  @unique
  status            String   @default("DRAFT")
  neededBy          DateTime?
  reason            String?
  notes             String?
  requestedAt       DateTime?
  approvedAt        DateTime?
  convertedAt       DateTime?
  purchaseOrderId   String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id])
  branch            Branch   @relation(fields: [branchId], references: [id])
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  items             PurchaseRequestItem[]
  @@index([companyId, branchId, status, createdAt])
  @@index([warehouseId, status])
  @@index([supplierId, status])
}

model PurchaseRequestItem {
  id                String   @id @default(uuid())
  purchaseRequestId String
  productId         String
  quantity          Int
  estimatedUnitCost Decimal
  notes             String?
  createdAt         DateTime @default(now())
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
  @@index([purchaseRequestId])
  @@index([productId])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  number         String              @unique
  supplierId     String
  warehouseId    String
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  subtotal       Decimal
  discount       Decimal             @default(0)
  tax            Decimal             @default(0)
  total          Decimal
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id])
  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]
  @@index([warehouseId, status, orderDate])
  @@index([supplierId, orderDate])
  @@index([createdAt, id])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  variantId       String?
  productUnitId   String?
  unitCode        String?
  unitQuantity    Int?
  quantityFactor  Int           @default(1)
  orderedQty      Int
  receivedQty     Int           @default(0)
  unitCost        Decimal
  purchaseUnitCost Decimal?
  subtotal        Decimal
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
  receiptItems    GoodsReceiptItem[]
  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  number          String             @unique
  purchaseOrderId String
  supplierId      String
  warehouseId     String
  supplierInvoice String?
  deliveryNote    String?
  operationalStatus GoodsReceiptOperationalStatus @default(DRAFT)
  inspectionRequired Boolean @default(true)
  inspectionId    String?
  confirmedAt     DateTime?
  confirmedById   String?
  taxTotal        Decimal            @default(0)
  grossTotal      Decimal            @default(0)
  accountingEventId String?          @unique
  receivedAt      DateTime           @default(now())
  notes           String?
  createdAt       DateTime           @default(now())
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  items           GoodsReceiptItem[]
  @@index([warehouseId, receivedAt])
  @@index([supplierId, receivedAt])
  @@index([purchaseOrderId])
  @@index([createdAt, id])
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  variantId           String?
  productUnitId       String?
  unitCode            String?
  unitQuantity        Int?
  damagedUnitQuantity Int?
  quantityFactor      Int               @default(1)
  quantityReceived    Int
  quantityDamaged     Int               @default(0)
  acceptedQty         Int
  unitCost            Decimal
  subtotal            Decimal
  taxCodeId           String?
  taxAmount           Decimal           @default(0)
  grossSubtotal       Decimal           @default(0)
  batchNumber         String?
  expiryDate          DateTime?
  serialNumbers       Json?
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])
  @@index([goodsReceiptId])
  @@index([productId])
}

model Customer {
  id        String   @id @default(uuid())
  companyId String?
  name      String
  phone     String?
  email     String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  address   String?
  points    Int      @default(0)
  customerType String @default("RETAIL")
  taxIdNumber String?
  taxProfile Json?
  defaultTaxCodeId String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
  sales     Sale[]
  orders    Order[]
  account   CustomerAccount?
  sessions  CustomerSession[]
  verificationTokens CustomerVerificationToken[]
  addresses CustomerAddress[]
  favorites ProductFavorite[]
  reviews   ProductReview[]
  orderReturns OrderReturn[]
  @@unique([companyId, email])
  @@index([companyId, name, id])
  @@index([companyId, phone])
}

model CustomerAccount {
  id             String   @id @default(uuid())
  customerId     String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerSession {
  id         String   @id @default(uuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model CustomerVerificationToken {
  id         String   @id @default(uuid())
  customerId String
  type       String
  targetHash String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId, type, createdAt])
  @@index([expiresAt, consumedAt])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  label       String   @default("Rumah")
  recipientName String
  phone       String
  addressLine String
  district    String?
  city        String?
  province    String?
  postalCode  String?
  notes       String?
  latitude    Decimal?
  longitude   Decimal?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId, isActive, isDefault])
}

model ProductFavorite {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([customerId, productId])
  @@index([productId, createdAt])
}

model ProductReview {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  orderId    String?
  rating     Int
  title      String?
  body       String?
  status     String   @default("PUBLISHED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([customerId, productId])
  @@index([productId, status, createdAt])
  @@index([customerId, createdAt])
}

model CashierShift {
  id             String   @id @default(uuid())
  userId         String
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  openingCash    Decimal
  closingCash    Decimal?
  expectedCash   Decimal?
  difference     Decimal?
  status         String   @default("OPEN")
  user           User     @relation(fields: [userId], references: [id])
  sales          Sale[]
  cashMovements  CashierCashMovement[]
}

model CashierCashMovement {
  id             String       @id @default(uuid())
  cashierShiftId String
  type           String
  amount         Decimal
  reason         String
  createdById    String
  createdAt      DateTime     @default(now())
  cashierShift   CashierShift @relation(fields: [cashierShiftId], references: [id], onDelete: Cascade)

  @@index([cashierShiftId, createdAt])
  @@index([createdById, createdAt])
}

model Sale {
  id             String       @id @default(uuid())
  number         String       @unique
  branchId       String
  warehouseId    String
  customerId     String?
  cashierShiftId String?
  channel        SaleChannel  @default(POS)
  status         SaleStatus   @default(COMPLETED)
  subtotal       Decimal
  discount       Decimal      @default(0)
  tax            Decimal      @default(0)
  // Service fee (card, QRIS, delivery). Kept separate from product revenue because it posts to a
  // service-income account, not 4101. Folding it into product revenue makes the branch P&L wrong.
  serviceFee     Decimal      @default(0)
  taxIncluded    Boolean      @default(false)
  accountingEventId String?   @unique
  taxDocumentId  String?
  total          Decimal
  costTotal      Decimal
  createdAt      DateTime     @default(now())
  branch         Branch       @relation(fields: [branchId], references: [id])
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  cashierShift   CashierShift? @relation(fields: [cashierShiftId], references: [id])
  items          SaleItem[]
  payments       Payment[]
  @@index([branchId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt, id])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  variantId String?
  productUnitId String?
  quantity  Int
  unitPrice Decimal
  unitCost  Decimal
  unitCode  String?
  unitQuantity Int?
  quantityFactor Int @default(1)
  sourceBarcode String?
  subtotal  Decimal
  netSubtotal Decimal @default(0)
  taxAmount Decimal @default(0)
  grossSubtotal Decimal @default(0)
  taxCodeId String?
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  @@index([saleId])
  @@index([productId, saleId])
}

model Order {
  id            String      @id @default(uuid())
  number        String      @unique
  branchId      String
  warehouseId   String
  customerId    String?
  customerName  String
  customerEmail String?
  customerPhone String?
  address       String
  fulfillmentType String    @default("DELIVERY")
  customerAddressId String?
  shippingMethodCode String?
  shippingMethodName String?
  pickupWarehouseId String?
  status        OrderStatus @default(PENDING_PAYMENT)
  subtotal      Decimal
  shippingCost  Decimal     @default(0)
  discount      Decimal     @default(0)
  tax           Decimal     @default(0)
  taxIncluded   Boolean     @default(false)
  accountingEventId String? @unique
  taxDocumentId String?
  total         Decimal
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  branch        Branch      @relation(fields: [branchId], references: [id])
  warehouse     Warehouse   @relation(fields: [warehouseId], references: [id])
  customer      Customer?   @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  returns       OrderReturn[]
  @@index([branchId, status, createdAt])
  @@index([warehouseId, status, createdAt])
  @@index([status, expiresAt])
  @@index([customerId, createdAt])
  @@index([customerPhone])
  @@index([createdAt, id])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  variantId String?
  productUnitId String?
  unitCode String?
  unitQuantity Int?
  quantityFactor Int @default(1)
  sourceBarcode String?
  quantity  Int
  unitPrice Decimal
  unitCost  Decimal
  subtotal  Decimal
  netSubtotal Decimal @default(0)
  taxAmount Decimal @default(0)
  grossSubtotal Decimal @default(0)
  taxCodeId String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  returnItems OrderReturnItem[]
  @@index([orderId])
  @@index([productId, orderId])
}

model Payment {
  id            String        @id @default(uuid())
  number        String        @unique
  saleId        String?
  orderId       String?
  method        String
  methodName    String?
  methodReferenceId String?
  methodSnapshot Json?
  provider      String?
  externalRef   String?
  amount        Decimal
  settlementAccountCode String?
  settlementBehavior String?
  feeAmount     Decimal       @default(0)
  feeAccountCode String?
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  accountingEventId String?
  taxTransactionId String?
  createdAt     DateTime      @default(now())
  sale          Sale?         @relation(fields: [saleId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id])
  @@index([status, createdAt])
  @@index([externalRef])
  @@index([saleId])
  @@index([orderId])
}

model PaymentProviderEvent {
  id            String   @id @default(uuid())
  companyId     String
  branchId      String?
  integrationId String
  provider      String
  eventId       String
  eventType     String
  externalRef   String?
  paymentId     String?
  orderId       String?
  amount        Decimal?
  requestHash   String
  status        String   @default("RECEIVED")
  payload       Json
  error         String?
  receivedAt    DateTime @default(now())
  processedAt   DateTime?

  @@unique([integrationId, eventId])
  @@index([companyId, branchId, receivedAt])
  @@index([provider, externalRef])
  @@index([paymentId])
  @@index([orderId])
}

model Account {
  id           String      @id @default(uuid())
  branchId     String
  code         String
  name         String
  type         AccountType
  isActive     Boolean     @default(true)
  branch       Branch      @relation(fields: [branchId], references: [id])
  journalLines JournalLine[]
  @@unique([branchId, code])
}

model JournalEntry {
  id            String        @id @default(uuid())
  number        String        @unique
  date          DateTime      @default(now())
  referenceType String
  referenceId   String
  description   String
  createdAt     DateTime      @default(now())
  lines         JournalLine[]
  @@index([date, id])
  @@index([referenceType, referenceId])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0)
  credit         Decimal      @default(0)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])
  @@index([journalEntryId])
  @@index([accountId, journalEntryId])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt, id])
  @@index([companyId, createdAt])
}


model StaffMemo {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String
  userId       String
  operationKey String
  requestHash  String
  title        String
  body         String
  isPinned     Boolean  @default(false)
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id])
  branch       Branch   @relation(fields: [branchId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, branchId, operationKey])
  @@index([companyId, branchId, userId, archivedAt, isPinned, updatedAt])
}

enum FeatureScope {
  GLOBAL
  COMPANY
  BRANCH
  USER
}

enum IntegrationType {
  PAYMENT
  SHIPPING
  MARKETPLACE
  NOTIFICATION
  ACCOUNTING
  STORAGE
  ANALYTICS
  IDENTITY
  DEVICE
  PPOB
  CUSTOM
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  DEGRADED
  DISABLED
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum StockTransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  PICKING
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
}

enum StockOpnameStatus {
  DRAFT
  COUNTING
  WAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum FinanceTransactionType {
  OPERATING_EXPENSE
  OTHER_INCOME
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  SUPPLIER_REFUND
  TAX_PAYMENT
  PAYROLL_LIABILITY_PAYMENT
  CASH_TRANSFER
  BANK_TRANSFER
  OTHER
}

enum FinanceTransactionStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  POSTED
  PAID
  CANCELLED
}

enum ReturnStatus {
  DRAFT
  REQUESTED
  APPROVED
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum SerialStatus {
  AVAILABLE
  IN_TRANSIT
  RESERVED
  SOLD
  RETURNED
  CONSUMED
  DAMAGED
  LOST
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRE
  REFUND
}

enum ReconciliationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OfflineSyncStatus {
  PENDING
  PROCESSING
  APPLIED
  CONFLICT
  FAILED
  DEAD_LETTER
}

enum ShipmentStatus {
  DRAFT
  READY
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum FiscalPeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

/// Feature flags make every major capability independently activatable.
model FeatureFlag {
  id        String       @id @default(uuid())
  companyId String?
  branchId  String?
  userId    String?
  key       String
  scope     FeatureScope @default(COMPANY)
  enabled   Boolean      @default(false)
  config    Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  @@unique([companyId, branchId, userId, key])
  @@index([key, enabled])
}

/// Hierarchical settings: global -> company -> branch -> user.
model SystemSetting {
  id        String   @id @default(uuid())
  companyId String?
  branchId  String?
  userId    String?
  namespace String
  key       String
  value     Json
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, branchId, userId, namespace, key])
  @@index([namespace, key])
}

/// Runtime module catalog for menus, permissions, and feature discovery.
model ModuleDefinition {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  version      String   @default("1.0.0")
  category     String
  featureKey   String?
  dependencies Json?
  capabilities Json?
  navigation   Json?
  isCore       Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Server-driven forms/tables/dashboard layouts.
model UiSchemaDefinition {
  id        String   @id @default(uuid())
  companyId String?
  branchId  String?
  code      String
  surface   String
  schema    Json
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, branchId, code, version])
}

/// Extend any entity without database migrations for every new field.
model CustomFieldDefinition {
  id           String   @id @default(uuid())
  companyId    String
  entityType   String
  key          String
  label        String
  dataType     String
  required     Boolean  @default(false)
  searchable   Boolean  @default(false)
  defaultValue Json?
  options      Json?
  validation   Json?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([companyId, entityType, key])
}

model CustomFieldValue {
  id           String   @id @default(uuid())
  definitionId String
  entityType   String
  entityId     String
  value        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([definitionId, entityId])
  @@index([entityType, entityId])
}

/// JSON-based conditions/actions for configurable automation.
model BusinessRule {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  trigger     String
  conditions  Json?
  actions     Json
  priority    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([companyId, code])
  @@index([trigger, isActive])
}

model NumberSequence {
  id          String   @id @default(uuid())
  companyId   String
  branchId    String?
  documentType String
  prefix      String
  format      String   @default("{PREFIX}-{YYYY}{MM}-{NUMBER}")
  nextNumber  Int      @default(1)
  padding     Int      @default(6)
  resetPolicy String   @default("MONTHLY")
  lastResetAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([companyId, branchId, documentType])
}

/// Provider-neutral connection. Secrets must be encrypted by the application.
model IntegrationConnection {
  id               String            @id @default(uuid())
  companyId        String
  branchId         String?
  type             IntegrationType
  provider         String
  name             String
  status           IntegrationStatus @default(DISCONNECTED)
  config           Json?
  encryptedSecrets String?
  capabilities     Json?
  lastHealthCheckAt DateTime?
  lastError        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  digitalServiceProducts DigitalServiceProduct[]
  digitalServiceTransactions DigitalServiceTransaction[]
  @@unique([companyId, branchId, type, provider, name])
}

model DigitalServiceProduct {
  id                 String   @id @default(uuid())
  companyId          String
  integrationId      String
  providerSku        String
  name               String
  category           String
  brand              String?
  type               String?
  sellerName         String?
  kind               String   @default("PREPAID")
  costPrice          Decimal?
  salePrice          Decimal
  buyerProductStatus Boolean  @default(true)
  sellerProductStatus Boolean @default(true)
  unlimitedStock     Boolean  @default(false)
  stock              Int?
  active             Boolean  @default(true)
  metadata           Json?
  syncedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  company            Company @relation(fields: [companyId], references: [id])
  integration        IntegrationConnection @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  @@unique([integrationId, providerSku])
  @@index([companyId, active, category, brand])
}

model DigitalServiceTransaction {
  id             String   @id @default(uuid())
  companyId      String
  branchId       String
  integrationId  String
  requestedById  String
  providerSku    String
  customerNo     String
  number         String   @unique
  idempotencyKey String
  kind           String   @default("PREPAID")
  sellingPrice   Decimal
  maxPrice       Decimal?
  costAmount     Decimal?
  status         DigitalServiceTransactionStatus @default(QUEUED)
  providerRef    String?
  providerRc     String?
  message        String?
  serialNumber   String?
  requestData    Json?
  responseData   Json?
  attempts       Int      @default(0)
  lastCheckedAt  DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company @relation(fields: [companyId], references: [id])
  branch         Branch @relation(fields: [branchId], references: [id])
  integration    IntegrationConnection @relation(fields: [integrationId], references: [id])
  requestedBy    User @relation(fields: [requestedById], references: [id])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, branchId, status, createdAt])
  @@index([integrationId, providerSku])
}

model ExternalMapping {
  id            String          @id @default(uuid())
  integrationId String
  entityType    String
  internalId    String
  externalId    String
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@unique([integrationId, entityType, internalId])
  @@unique([integrationId, entityType, externalId])
}

model WebhookEndpoint {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  url         String
  secretHash  String?
  events      Json
  headers     Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  endpointId  String
  eventId     String?
  eventType   String
  payload     Json
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  responseCode Int?
  responseBody String?
  nextRetryAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, nextRetryAt])
}

/// Transactional outbox for reliable integrations and notifications.
model EventOutbox {
  id            String   @id @default(uuid())
  companyId     String?
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  availableAt   DateTime @default(now())
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model ApprovalPolicy {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  entityType  String
  conditions  Json?
  steps       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([companyId, code])
}

model ApprovalRequest {
  id          String         @id @default(uuid())
  policyId    String?
  companyId   String
  branchId    String?
  entityType  String
  entityId    String
  requesterId String?
  amount      Decimal?
  status      ApprovalStatus @default(PENDING)
  currentStep Int            @default(1)
  context     Json?
  requestedAt DateTime       @default(now())
  expiresAt   DateTime?
  escalatedAt DateTime?
  delegatedToId String?
  delegatedById String?
  delegatedAt DateTime?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([entityType, entityId])
  @@index([status, requestedAt])
  @@index([companyId, branchId, status])
  @@index([status, expiresAt])
  @@index([delegatedToId, status])
}

model ApprovalDecision {
  id         String         @id @default(uuid())
  requestId  String
  step       Int
  approverId String
  status     ApprovalStatus
  notes      String?
  decidedAt  DateTime       @default(now())
  @@index([requestId, step])
}

model WarehouseLocation {
  id          String   @id @default(uuid())
  warehouseId String
  parentId    String?
  code        String
  name        String
  type        String   @default("BIN")
  barcode     String?
  capacity    Decimal?
  metadata    Json?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([warehouseId, code])
}

model InventoryLocationBalance {
  id          String   @id @default(uuid())
  warehouseId String
  locationId  String
  productId   String
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  available   Int      @default(0)
  updatedAt   DateTime @updatedAt
  @@unique([locationId, productId])
  @@index([warehouseId, productId])
  @@index([warehouseId, available])
}

model InventoryReservation {
  id          String   @id @default(uuid())
  warehouseId String
  locationId  String
  productId   String
  sourceType  String
  sourceId    String
  quantity    Int
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([sourceType, sourceId, locationId, productId])
  @@index([warehouseId, productId, status])
  @@index([sourceType, sourceId, status])
