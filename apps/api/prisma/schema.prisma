model ApiKey {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  keyPrefix   String
  secretHash  String
  scopes      Json
  // POST-1D. Pins the key to exactly one branch. A key is company-scoped today and picks its branch
  // from a request header, which is right for a back-office integration and wrong for a customer-
  // facing kiosk: anyone holding a kiosk key could point it at another branch's prices by editing a
  // header. A pinned key ignores the header instead. Left as a plain column with no @relation so this
  // stays additive — nullable means every existing row keeps its current multi-branch behaviour.
  branchId    String?
  // POST-1D. Where the device physically is ("kasir 2", "pintu masuk"), for the operator's benefit
  // only. It is never shown to a customer and never affects a price.
  locationLabel String?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([companyId, keyPrefix])
}

