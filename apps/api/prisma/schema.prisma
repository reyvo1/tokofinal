// POST-1A — Edge topology and sync foundation.
//
// The existing edge-sync controller synchronises a POS *device* with a server: HMAC-signed
// device credentials, an OfflineTransaction inbox keyed by (deviceId, localId). That is not
// what POST-1A asks for. POST-1A is branch-to-central: each branch runs its own TOKO360 server
// and reconciles with the central host as a peer, so it needs node identity, peer registration,
// a durable outbox per node, a cursor per (node, peer) pair, and a dead-letter path.
//
// These models are additive and reference no new foreign keys, so they are safe to add before the
// current P0-P7 work is closed. They are not referenced by any canonical domain owner, so they
// cannot change existing business semantics until a sync wave actually writes through them.

// A TOKO360 server participating in the topology. CENTRAL consolidates; BRANCH originates.
model SyncNode {
  id            String        @id @default(uuid())
  companyId     String
  code          String
  name          String
  role          SyncNodeRole  @default(BRANCH)
  branchId      String?
  protocolVersion Int         @default(1)
  isActive      Boolean       @default(true)
  lastHeartbeatAt DateTime?
  // How many inbound deliveries this node suppressed as duplicates. A counter, not a row per event:
  // SyncInbox is uniquely keyed on (nodeId, eventId), so a duplicate can never be recorded there —
  // counting inbox rows with outcome DUPLICATE is structurally always zero, and an observability
  // number that cannot move is worse than no number because it reads as "no duplicates happened".
  duplicatesSuppressed Int       @default(0)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@unique([companyId, code])
  @@index([companyId, role, isActive])
}

// Registration of one peer by another. Auth direction is always node -> peer, never assumed.
model SyncPeer {
  id            String        @id @default(uuid())
  companyId     String
  nodeId        String
  peerNodeId    String
  direction     SyncDirection @default(BIDIRECTIONAL)
  sharedSecretRef String
  isActive      Boolean       @default(true)
  lastSyncAt    DateTime?
  lastError     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@unique([nodeId, peerNodeId])
  @@index([companyId, isActive])
}

// Durable outbox. One row per business mutation that must reach the peer. eventId is the
// idempotency key: replaying the same eventId is a no-op, never a second stock or journal posting.
model SyncOutbox {
  id            String        @id @default(uuid())
  companyId     String
  nodeId        String
  eventId       String        @unique
  aggregateType String
  aggregateId   String
  eventType     String
  schemaVersion Int           @default(1)
  payload       Json
  status        SyncEventStatus @default(PENDING)
  attempts      Int           @default(0)
  nextRetryAt   DateTime?
  deadLetteredAt DateTime?
  lastError     String?
  createdAt     DateTime      @default(now())
  publishedAt   DateTime?
  @@index([nodeId, status, createdAt])
  @@index([companyId, aggregateType, aggregateId])
}

// Per (node, peer) checkpoint. Lets a reconnect ask for "everything after this" instead of
// resending the whole history, and makes observable lag computable rather than guessed.
model SyncCursor {
  id            String   @id @default(uuid())
  companyId     String
  nodeId        String
  peerNodeId    String
  cursor        String?
  lastEventId   String?
  lastSyncAt    DateTime?
  lagCount      Int      @default(0)
  updatedAt     DateTime @updatedAt
  @@unique([nodeId, peerNodeId])
  @@index([companyId, nodeId])
}

// Inbound event log on the receiving side. Records the decision (applied, duplicate, conflict,
// rejected) so a duplicate replay is provable after the fact rather than merely unlikely.
model SyncInbox {
  id            String        @id @default(uuid())
  companyId     String
  nodeId        String
  peerNodeId    String
  eventId       String
  eventType     String
  schemaVersion Int           @default(1)
  outcome       SyncInboxOutcome @default(APPLIED)
  conflict      Json?
  errorMessage  String?
  payloadDigest String?
  receivedAt    DateTime      @default(now())
  @@unique([nodeId, eventId])
  @@index([companyId, outcome, receivedAt])
}

enum SyncNodeRole {
  CENTRAL
  BRANCH
}

enum SyncDirection {
  PUSH
  PULL
  BIDIRECTIONAL
}

enum SyncEventStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum SyncInboxOutcome {
  APPLIED
  DUPLICATE
  CONFLICT
  REJECTED
}

// POST-1A — peer transport security.
//
// A device nonce is not enough for node-to-node traffic: a branch server is a long-lived peer that
// retries in bulk, so its requests need their own replay window. Without this table a captured
// signature could be replayed against a peer and re-deliver an entire batch of events.
model SyncPeerNonce {
  id         String   @id @default(uuid())
  peerId     String
  nonce      String
  requestHash String
  requestAt  DateTime
  createdAt  DateTime @default(now())
  @@unique([peerId, nonce])
  @@index([peerId, createdAt])
}

// POST-1A — conflict and reconciliation.
//
// A branch that sold the last unit offline and central that received a transfer for it before the
// partition both believe they are right. Whichever lands second must be detectable as a conflict and
// resolved by an explicit, recorded policy — not by "last write wins", which silently discards one
// branch's sale and leaves inventory that never existed.
//
// baseVersion is the aggregate version the writer believed it was editing. It is the only evidence
// that can distinguish "I edited the current state" from "I edited a state that had since moved".
model SyncConflict {
  id            String   @id @default(uuid())
  companyId     String
  nodeId        String
  peerNodeId    String
  eventId       String
  aggregateType String
  aggregateId   String
  baseVersion   Int
  remoteVersion Int?
  strategy      SyncConflictStrategy @default(PENDING)
  resolution    Json?
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  @@unique([nodeId, eventId])
  @@index([companyId, strategy, createdAt])
  @@index([aggregateType, aggregateId, strategy])
}

// Per-aggregate version watermark per node. A branch increments its own; central records the highest
// version it has observed. A writer whose baseVersion is behind the watermark is a conflict.
model SyncAggregateVersion {
  id            String   @id @default(uuid())
  companyId     String
  nodeId        String
  aggregateType String
  aggregateId   String
  version       Int      @default(0)
  lastEventId   String?
  updatedAt     DateTime @updatedAt
  @@unique([nodeId, aggregateType, aggregateId])
  @@index([companyId, aggregateType, aggregateId])
}

enum SyncConflictStrategy {
  PENDING
  KEEP_LOCAL
  KEEP_REMOTE
  MANUAL_REVIEW
}

// POST-1B — local-first branch continuity.
//
// The roadmap's hard rule: "No flow may silently pretend it is globally current when a branch is
// disconnected." A POS screen that shows a price or a stock number without saying where it came from
// is worse than one that refuses, because the operator cannot tell a stale read from a true one.
//
// So offline capability is declared per flow, per node, and carries the authority that produced the
// data. An offline read is a valid answer only when the flow is declared offline-capable AND the
// caller is told it came from the last synchronized snapshot.

// Per-flow declaration: which business flows may proceed against a disconnected local server.
model OfflineCapability {
  id           String   @id @default(uuid())
  companyId    String
  flowCode     String
  label        String
  // What the operator loses when this flow runs offline. Empty means the flow is safe to run
  // disconnected; a non-empty value must be surfaced, never buried.
  degradedImpact String?
  // Whether the flow may proceed at all without a peer. False means the branch must fail closed.
  offlineCapable Boolean  @default(false)
  // True when a write here is authoritative locally and reconciles upward; false means the flow is
  // read-only offline.
  localAuthoritative Boolean @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([companyId, flowCode])
  @@index([companyId, isActive, offlineCapable])
}

// Per-node override. The same flow can be offline-capable at one branch and not another, for
// legitimate reasons: a branch selling perishables should not be allowed to sell them blind.
model NodeCapabilityPolicy {
  id            String   @id @default(uuid())
  companyId     String
  nodeId        String
  flowCode      String
  offlineCapable Boolean
  degradedImpact String?
  updatedAt     DateTime @updatedAt
  @@unique([nodeId, flowCode])
  @@index([companyId, nodeId])
}

// A point-in-time record of what a branch read and when it became stale. This is what lets an
// answer say "as of 14:32, 6 hours behind central" instead of pretending to be current.
model SyncReadWatermark {
  id            String   @id @default(uuid())
  companyId     String
  nodeId        String
  resource      String
  lastSyncedAt  DateTime
  sourceCursor  String?
  updatedAt     DateTime @updatedAt
  @@unique([nodeId, resource])
  @@index([companyId, nodeId])
}

// Operator-visible branch connection state. Recorded centrally so the dashboard can report a branch
// as offline without the branch having to be reachable to say so.
model BranchConnectivity {
  id            String   @id @default(uuid())
  companyId     String
  branchId      String
  nodeId        String?
  state         BranchConnectionState @default(UNKNOWN)
  lastSeenAt    DateTime?
  lastSyncAt    DateTime?
  lagCount      Int      @default(0)
  reason        String?
  updatedAt     DateTime @updatedAt
  @@unique([companyId, branchId])
  @@index([companyId, state, lastSeenAt])
}

enum BranchConnectionState {
  // Never heard from. Distinct from OFFLINE: an unconfigured branch and a dead branch are
  // different problems and must not collapse into one red dot.
  UNKNOWN
  ONLINE
  // Reachable but behind. Still authoritative for its own branch; not consolidated yet.
  DEGRADED
  OFFLINE
  // Deliberately disconnected, e.g. maintenance. Reported differently so nobody chases a ghost.
  SUSPENDED
}

// POST-1B — offline inter-branch transfer.
//
// StockTransfer already has a complete lifecycle, and shipTransfer already moves stock to IN_TRANSIT
// when the goods leave. That means the "in the van" leg already exists; what it does not have is the
// acknowledgement leg for a branch that is not currently reachable.
//
// This model is purely additive. StockTransfer's enum and its ship/receive semantics are untouched,
// because changing those would alter a lifecycle the rest of the inventory module already depends on.
model BranchTransferSync {
  id                     String   @id @default(uuid())
  companyId              String
  transferId             String
  sourceNodeId           String
  destinationNodeId      String?
  // Shipment is real the moment goods leave the source warehouse, so this is set locally and never
  // waits for the destination. The destination acknowledgement is the part that has to wait.
  shippedEventId         String?
  destinationAckedAt     DateTime?
  destinationAckedBy     String?
  state                  BranchTransferSyncState @default(AWAITING_DESTINATION)
  // What the source believes and what the destination actually reported. A silent difference here is
  // how a branch ends up short without anyone noticing, so the two are stored, never reconciled by
  // assuming they agree.
  sourceQuantity         Int      @default(0)
  destinationQuantity    Int?
  discrepancyReason      String?
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())
  @@unique([transferId])
  @@index([companyId, state, updatedAt])
}

enum BranchTransferSyncState {
  // Goods left the source; the destination has not confirmed. This is the normal offline case.
  AWAITING_DESTINATION
  // Destination confirmed, quantities agree.
  CONVERGED
  // Destination confirmed with a different quantity. Must be reviewed by a human.
  DISCREPANT
  // The destination branch could not be reached at all and the operator cancelled the leg.
  ABANDONED
}

// POST-1C — Telegram identity binding and mobile stock-opname drafts.
//
// Security invariants from the roadmap, encoded in the schema rather than in comments:
//
//   "Telegram identity must map to an active authorized employee binding." The binding is therefore a
//   row that points at an Employee, and a binding with no live employee behind it resolves to nothing
//   — there is no path from a chat id to a permission without traversing this table.
//
//   "No direct database writes from bot handlers." A chat id is never sufficient on its own; the
//   binding carries the tenant, and every command resolves permissions through the bound Employee
//   rather than through anything the chat supplied.
model TelegramIdentityBinding {
  id            String   @id @default(uuid())
  companyId     String
  employeeId    String
  // The chat/user identifier from the platform, stored opaque. Never used as an identity on its own.
  platformUserId String
  platformChatId String?
  displayName   String?
  isActive      Boolean  @default(true)
  // Set when the employee stops being active, so an audit can answer "was this revoked or was it
  // never valid" rather than only "is it valid now".
  revokedAt     DateTime?
  revokedReason String?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([platformUserId])
  @@index([companyId, isActive])
  @@index([employeeId, isActive])
}

// A locally held stock-opname draft, keyed by the device that captured it. This is the offline
// storage the mobile surface needs; the count itself still has to post through the existing
// canonical StockOpname lifecycle, so a draft is never authoritative inventory.
//
// deviceId is part of the identity on purpose: a resumed draft belongs to the session that started
// it, and two devices counting the same rack must not overwrite each other's lines.
model MobileOpnameDraft {
  id           String   @id @default(uuid())
  companyId    String
  employeeId   String
  deviceId     String
  warehouseId  String
  locationId   String?
  // Reusing an existing StockOpname number is what ties the draft to the canonical lifecycle when it
  // is finally posted, rather than creating a parallel counting process.
  opnameId     String?
  // Free-form line capture: barcode, SKU, counted quantity, unit, note. Deliberately Json so a
  // thousand-line draft does not need a schema migration per new scan field.
  lines       Json
  status      MobileDraftStatus @default(OPEN)
  deviceLocalAt DateTime?
  lastScannedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([deviceId, warehouseId, locationId, status])
  @@index([companyId, employeeId, status])
  @@index([opnameId])
}

enum MobileDraftStatus {
  OPEN
  // Submitted for posting into the canonical StockOpname lifecycle; no longer editable.
  SUBMITTED
  // Posted successfully. Terminal, and the same immutable receipt the canonical flow produces.
  POSTED
  // Set aside by the operator. Kept rather than deleted: a discarded count is evidence too.
  DISCARDED
}
