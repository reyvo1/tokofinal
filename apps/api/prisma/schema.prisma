model AttendanceEvent {
  id              String              @id @default(uuid())
  companyId       String
  branchId        String?
  employeeId      String
  eventType       AttendanceEventType
  method          AttendanceMethod
  occurredAt      DateTime
  receivedAt      DateTime            @default(now())
  deviceId        String?
  geofenceId      String?
  externalEventId String?
  operationId     String?
  latitude        Decimal?
  longitude       Decimal?
  accuracyMeters  Decimal?
  distanceMeters  Decimal?
  insideGeofence  Boolean?
  photoEvidenceId String?
  livenessScore   Decimal?
  faceMatchScore  Decimal?
  sourcePayload   Json?
  validationFlags Json?
  status          String              @default("ACCEPTED")
  createdAt       DateTime            @default(now())
  @@unique([companyId, externalEventId])
  @@unique([companyId, operationId])
  @@index([employeeId, occurredAt])
  @@index([companyId, branchId, occurredAt])
  @@index([deviceId, occurredAt])
  @@index([status, receivedAt])
}

model AttendancePhotoEvidence {
  id              String   @id @default(uuid())
  companyId       String
  employeeId      String
  objectKey       String
  thumbnailKey    String?
  contentHash     String?
  capturedAt      DateTime
  latitude        Decimal?
  longitude       Decimal?
  livenessProvider String?
  livenessScore   Decimal?
  faceMatchScore  Decimal?
  consentVersion  String?
  retentionUntil  DateTime?
  encryptionKeyRef String?
  metadata        Json?
  createdAt       DateTime @default(now())
  @@index([employeeId, capturedAt])
  @@index([retentionUntil])
}

model AttendanceRecord {
  id             String                 @id @default(uuid())
  companyId      String
  branchId       String?
  employeeId     String
  scheduleId     String?
  workDate       DateTime
  firstCheckInAt DateTime?
  lastCheckOutAt DateTime?
  workedMinutes  Int                    @default(0)
  breakMinutes   Int                    @default(0)
  lateMinutes    Int                    @default(0)
  earlyLeaveMinutes Int                 @default(0)
  overtimeMinutes Int                   @default(0)
  status         AttendanceRecordStatus @default(INCOMPLETE)
  sourceVersion  Int                    @default(1)
  calculatedAt   DateTime?
  lockedAt       DateTime?
  notes          String?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  @@unique([employeeId, workDate])
  @@index([companyId, branchId, workDate])
  @@index([status, workDate])
}

model AttendanceCorrection {
  id             String                @id @default(uuid())
  companyId      String
  employeeId     String
  attendanceRecordId String?
  requestedById  String
  reason         String
  proposedData   Json
  status         ApprovalRequestStatus @default(SUBMITTED)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  @@index([companyId, status, createdAt])
  @@index([employeeId, createdAt])
}

model LeaveType {
  id             String   @id @default(uuid())
  companyId      String
  code           String
  name           String
  paid           Boolean  @default(true)
  annualQuota    Decimal?
  requiresDocument Boolean @default(false)
  rules          Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([companyId, code])
}

model LeaveRequest {
  id             String                @id @default(uuid())
  companyId      String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  totalDays      Decimal
  reason         String?
  documentObjectKey String?
  status         ApprovalRequestStatus @default(SUBMITTED)
  approvalRequestId String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  @@index([employeeId, startDate])
  @@index([companyId, status, startDate])
}

model OvertimeRequest {
  id             String                @id @default(uuid())
  companyId      String
  employeeId     String
  branchId       String?
  requestedStart DateTime
  requestedEnd   DateTime
  approvedMinutes Int?
  reason         String?
  status         ApprovalRequestStatus @default(SUBMITTED)
  approvalRequestId String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  @@index([employeeId, requestedStart])
  @@index([companyId, status, requestedStart])
}

model PayrollComponentDefinition {
  id              String                 @id @default(uuid())
  companyId       String
  code            String
  name            String
  componentType   PayrollComponentType
  calculationType PayrollCalculationType
  formula         String?
  defaultAmount   Decimal?
  taxable         Boolean                @default(true)
  affectsGross    Boolean                @default(true)
  affectsNet      Boolean                @default(true)
  proratable      Boolean                @default(false)
  attendanceBased Boolean                @default(false)
  displayOrder    Int                    @default(0)
  metadata        Json?
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  @@unique([companyId, code])
  @@index([companyId, componentType, isActive])
}

model EmployeePayrollComponent {
  id            String   @id @default(uuid())
  companyId     String
  employeeId    String
  componentId   String
  amount        Decimal?
  percentage    Decimal?
  formulaInputs Json?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([employeeId, effectiveFrom])
  @@index([componentId, isActive])
}

model PayrollPeriod {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  year        Int
  month       Int
  startDate   DateTime
  endDate     DateTime
  attendanceCutoffAt DateTime?
  status      String   @default("OPEN")
  lockedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([companyId, code])
  @@unique([companyId, year, month])
  @@index([companyId, startDate, endDate])
}

model PayrollRun {
  id             String           @id @default(uuid())
  companyId      String
  branchId       String?
  payrollPeriodId String
  number         String
  status         PayrollRunStatus @default(DRAFT)
  taxRuleSetId   String?
  socialSecurityRuleSetId String?
  employeeCount  Int              @default(0)
  grossTotal     Decimal @default(0)
  deductionTotal Decimal @default(0)
  taxTotal       Decimal @default(0)
  employerContributionTotal Decimal @default(0)
  netTotal       Decimal @default(0)
  calculatedAt   DateTime?
  approvedById   String?
  approvedAt     DateTime?
  postedJournalEntryId String?
  adjustmentOfRunId String?
  adjustmentSequence Int            @default(0)
  adjustmentReason String?
  adjustmentPostingDate DateTime?
  createdById    String
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@unique([companyId, number])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, branchId, status, createdAt])
  @@unique([companyId, branchId, adjustmentOfRunId, adjustmentSequence])
  @@index([payrollPeriodId, status])
}

model PayrollResult {
  id                  String   @id @default(uuid())
  companyId           String
  payrollRunId        String
  payrollPeriodId     String
  employeeId          String
  attendanceSnapshot  Json?
  grossPay            Decimal @default(0)
  taxableIncome       Decimal @default(0)
  employeeContribution Decimal @default(0)
  employerContribution Decimal @default(0)
  incomeTax           Decimal @default(0)
  otherDeductions     Decimal @default(0)
  netPay              Decimal @default(0)
  calculationTrace    Json?
  status              String   @default("CALCULATED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@unique([payrollRunId, employeeId])
  @@index([employeeId, payrollPeriodId])
  @@index([companyId, payrollPeriodId, status])
}

model PayrollLine {
  id              String               @id @default(uuid())
  payrollResultId String
  componentId     String?
  code            String
  name            String
  componentType   PayrollComponentType
  quantity        Decimal?
  rate            Decimal?
  amount          Decimal
  taxableAmount   Decimal @default(0)
  employerAmount  Decimal @default(0)
  source          String?
  metadata        Json?
  createdAt       DateTime             @default(now())
  @@index([payrollResultId, componentType])
  @@index([componentId])
}

model Payslip {
  id               String   @id @default(uuid())
  companyId        String
  employeeId       String
  payrollResultId  String   @unique
  number           String
  objectKey        String?
  secureTokenHash  String?
  tokenExpiresAt   DateTime?
  generatedAt      DateTime?
  viewedAt         DateTime?
  acknowledgedAt   DateTime?
  dataSnapshot     Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([companyId, number])
  @@index([employeeId, createdAt])
  @@index([tokenExpiresAt])
}

model PayrollPayment {
  id             String               @id @default(uuid())
  companyId      String
  payrollRunId   String
  payrollResultId String
  employeeId     String
  paymentMethod  String
  direction      String               @default("OUTBOUND")
  bankAccountTokenRef String?
  settlementAccountCode String?
  accountingEventId String? @unique
  amount         Decimal
  status         PayrollPaymentStatus @default(PENDING)
  externalReference String?
  paidAt         DateTime?
  failureReason  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  @@unique([payrollResultId])
  @@index([companyId, status, createdAt])
  @@index([payrollRunId, status])
}

model PayrollAccountingMapping {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String?
  componentCode     String
  debitAccountId    String?
  creditAccountId   String?
  employerDebitAccountId String?
  employerCreditAccountId String?
  rules             Json?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([companyId, branchId, componentCode])
}

model TaxRuleSet {
  id               String   @id @default(uuid())
  companyId        String
  countryCode      String   @default("ID")
  code             String
  name             String
  legalReference   String?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  calculationMode  String
  parameters       Json
  version          Int      @default(1)
  status           String   @default("DRAFT")
  checksum         String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([companyId, code, version])
  @@index([companyId, countryCode, effectiveFrom, status])
}

model TaxRule {
  id          String   @id @default(uuid())
  taxRuleSetId String
  code        String
  priority    Int      @default(0)
  conditions  Json
  formula     Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([taxRuleSetId, code])
  @@index([taxRuleSetId, priority, isActive])
}

model EmployeeTaxProfile {
  id               String   @id @default(uuid())
  companyId        String
  employeeId       String
  countryCode      String   @default("ID")
  taxStatusCode    String?
  taxIdSecretRef   String?
  taxMethod        String   @default("GROSS")
  annualizationMethod String?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  attributes       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([employeeId, effectiveFrom])
  @@index([companyId, taxStatusCode])
  @@index([companyId, employeeId, effectiveFrom])
}

model SocialSecurityRuleSet {
  id              String   @id @default(uuid())
  companyId       String
  countryCode     String   @default("ID")
  code            String
  name            String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  parameters      Json
  version         Int      @default(1)
  status          String   @default("DRAFT")
  legalReference  String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([companyId, code, version])
  @@index([companyId, effectiveFrom, status])
}

model EmployeeSocialSecurityProfile {
  id              String   @id @default(uuid())
  companyId       String
  employeeId      String
  healthMemberSecretRef String?
  employmentMemberSecretRef String?
  wageBase        Decimal?
  programs        Json
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([employeeId, effectiveFrom])
  @@index([companyId, effectiveFrom])
  @@index([companyId, employeeId, effectiveFrom])
}

model EmployeeChannelBinding {
  id              String          @id @default(uuid())
  companyId       String
  employeeId      String
  channel         EmployeeChannel
  addressEncrypted String?
  addressHash     String?
  externalUserId  String?
  verificationTokenHash String?
  verifiedAt      DateTime?
  revokedAt       DateTime?
  isPrimary       Boolean         @default(false)
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@unique([employeeId, channel, addressHash])
  @@index([companyId, channel, verifiedAt])
}

model EmployeeNotificationPreference {
  id          String          @id @default(uuid())
  companyId   String
  employeeId  String
  eventCode   String
  channel     EmployeeChannel
  enabled     Boolean         @default(true)
  quietHours  Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@unique([employeeId, eventCode, channel])
  @@index([companyId, eventCode, enabled])
}

model EmployeeNotificationDelivery {
  id          String          @id @default(uuid())
  companyId   String
  employeeId  String
  payrollResultId String?
  eventCode   String
  channel     EmployeeChannel
  notificationId String?
  status      String          @default("QUEUED")
  externalReference String?
  attempts    Int             @default(0)
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([companyId, status, createdAt])
  @@index([employeeId, eventCode, createdAt])
}

/// Daily attendance aggregate for dashboards without scanning raw events.
model DailyAttendanceSummary {
  id              String   @id @default(uuid())
  companyId       String
  branchId        String?
  businessDate    DateTime
  scheduledCount  Int      @default(0)
  presentCount    Int      @default(0)
  lateCount       Int      @default(0)
  absentCount     Int      @default(0)
  leaveCount      Int      @default(0)
  incompleteCount Int      @default(0)
  workedMinutes   Int      @default(0)
  overtimeMinutes Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([companyId, branchId, businessDate])
  @@index([companyId, businessDate])
  @@index([branchId, businessDate])
}

/// Payroll period aggregate for management and accounting dashboards.
model PayrollPeriodSummary {
  id                     String   @id @default(uuid())
  companyId              String
  branchId               String?
  payrollPeriodId        String
  employeeCount          Int      @default(0)
  grossTotal             Decimal @default(0)
  deductionTotal         Decimal @default(0)
  employeeContributionTotal Decimal @default(0)
  employerContributionTotal Decimal @default(0)
  taxTotal               Decimal @default(0)
  netTotal               Decimal @default(0)
  status                  String   @default("CALCULATED")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  @@unique([payrollPeriodId, branchId])
  @@index([companyId, payrollPeriodId])
  @@index([branchId, payrollPeriodId])
}


// -----------------------------------------------------------------------------
// Enterprise accounting, tax, assets, fleet, inspection and automation v0.5
// -----------------------------------------------------------------------------

enum GoodsReceiptOperationalStatus {
  DRAFT
  PENDING_INSPECTION
  READY_TO_CONFIRM
  CONFIRMED
  PARTIALLY_ACCEPTED
  REJECTED
  CANCELLED
}

enum AccountingEventStatus {
  PENDING
  VALIDATED
  POSTED
  FAILED
  REVERSED
  CANCELLED
}

enum AccountingRuleStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum TaxScope {
  SALE
  PURCHASE
  EXPENSE
  ASSET
  PAYROLL
  SHIPPING
  WITHHOLDING
  OTHER
}

enum TaxTransactionDirection {
  INPUT
  OUTPUT
  WITHHOLDING
  SELF_ASSESSED
}

enum TaxTransactionStatus {
  CALCULATED
  POSTED
  REVERSED
  CANCELLED
}

enum AssetType {
  MOVABLE
  IMMOVABLE
  VEHICLE
  LAND
  BUILDING
  EQUIPMENT
  FURNITURE
  IT
  SOFTWARE
  OTHER
}

enum AssetStatus {
  DRAFT
  ACTIVE
  IDLE
  IN_MAINTENANCE
  DAMAGED
  LOST
  SOLD
  DISPOSED
}

enum AssetTransactionType {
  ACQUISITION
  CAPITALIZATION
  DEPRECIATION
  IMPAIRMENT
  REVALUATION
  TRANSFER
  MAINTENANCE
  SALE
  DISPOSAL
}

enum MaintenanceStatus {
  PLANNED
  OPEN
  IN_PROGRESS
  WAITING_PART
  COMPLETED
  CANCELLED
}

enum InspectionType {
  PURCHASE_INBOUND
  TRANSFER_INBOUND
  SALE_OUTBOUND
  ORDER_OUTBOUND
  RETURN_INBOUND
  VEHICLE_PRETRIP
  VEHICLE_POSTTRIP
  ASSET_HANDOVER
  ASSET_PERIODIC
  DELIVERY_PROOF
  GATE_SECURITY
  OTHER
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  PASSED
  PARTIAL
  FAILED
  REVIEW_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
}

enum InspectionResultCode {
  PASS
  FAIL
  OBSERVATION
  NOT_APPLICABLE
}

enum ConfirmationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GatePassDirection {
  INBOUND
  OUTBOUND
}

enum GatePassStatus {
  DRAFT
  CHECKING
  APPROVED
  EXITED
  ENTERED
  REJECTED
  CANCELLED
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  ON_TRIP
  MAINTENANCE
  INACTIVE
  DISPOSED
}

enum DeliveryTripStatus {
  DRAFT
  PLANNED
  LOADING
  READY_TO_DISPATCH
  DISPATCHED
  IN_TRANSIT
  PARTIALLY_DELIVERED
  DELIVERED
  RETURNING
  CLOSED
  CANCELLED
}

enum DeliveryStopStatus {
  PENDING
  ARRIVED
  DELIVERED
  PARTIAL
  FAILED
  RETURNED
  SKIPPED
}

enum AutomationJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYING
  FAILED
  CANCELLED
}

model AccountingEvent {
  id             String                @id @default(uuid())
  companyId      String
  branchId       String?
  eventType      String
  sourceType     String
  sourceId       String
  idempotencyKey String
  businessDate   DateTime              @default(now())
  currency       String                @default("IDR")
  netAmount      Decimal               @default(0)
  taxAmount      Decimal               @default(0)
  grossAmount    Decimal               @default(0)
  status         AccountingEventStatus @default(PENDING)
  context        Json?
  errorMessage   String?
  journalEntryId String?
  reversalOfId   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  lines          AccountingEventLine[]
  postings       AccountingPosting[]
  taxTransactions TaxTransaction[]
  @@unique([companyId, idempotencyKey])
  @@index([companyId, branchId, createdAt, id])
  @@index([companyId, eventType, businessDate])
  @@index([sourceType, sourceId])
  @@index([status, createdAt])
}

model AccountingEventLine {
  id                String          @id @default(uuid())
  accountingEventId String
  lineNumber        Int
  itemType          String?
  itemId            String?
  description       String?
  quantity          Decimal         @default(0)
  unitAmount        Decimal         @default(0)
  netAmount         Decimal         @default(0)
  taxAmount         Decimal         @default(0)
  grossAmount       Decimal         @default(0)
  taxCodeId         String?
  dimensions        Json?
  event             AccountingEvent @relation(fields: [accountingEventId], references: [id], onDelete: Cascade)
  @@unique([accountingEventId, lineNumber])
  @@index([itemType, itemId])
  @@index([taxCodeId])
}

model AccountingPostingRule {
  id            String               @id @default(uuid())
  companyId     String
  code          String
  version       Int                  @default(1)
  name          String
  eventType     String
  priority      Int                  @default(100)
  status        AccountingRuleStatus @default(DRAFT)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  conditions    Json?
  journalLines  Json
  taxBehavior   Json?
  dimensions    Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  @@unique([companyId, code, version])
  @@index([companyId, eventType, status, priority])
}

model AccountingPosting {
  id                String          @id @default(uuid())
  accountingEventId String
  ruleId             String?
  journalEntryId     String
  status             String          @default("POSTED")
  postingTrace       Json?
  postedAt           DateTime        @default(now())
  reversedAt         DateTime?
  event              AccountingEvent @relation(fields: [accountingEventId], references: [id], onDelete: Cascade)
  @@index([journalEntryId])
  @@index([ruleId, postedAt])
}

model TaxCode {
  id                    String    @id @default(uuid())
  companyId             String
  code                  String
  version               Int       @default(1)
  name                  String
  scope                 TaxScope
  rate                  Decimal   @default(0)
  inclusive             Boolean   @default(false)
  recoverable           Boolean   @default(false)
  payableAccountCode    String?
  receivableAccountCode String?
  expenseAccountCode    String?
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  status                String    @default("DRAFT")
  calculationRules      Json?
  legalReference        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([companyId, code, version])
  @@index([companyId, code, status, effectiveFrom])
  @@index([companyId, scope, status])
}

model TaxTransaction {
  id                String                  @id @default(uuid())
  companyId         String
  branchId          String?
  accountingEventId String?
  sourceType        String
  sourceId          String
  taxCodeId         String
  direction         TaxTransactionDirection
  transactionDate   DateTime                @default(now())
  taxPeriod         String?
  taxableBase       Decimal                 @default(0)
  taxAmount         Decimal                 @default(0)
  status            TaxTransactionStatus    @default(CALCULATED)
  counterpartyType  String?
  counterpartyId    String?
  documentNumber    String?
  metadata          Json?
  createdAt         DateTime                @default(now())
  event             AccountingEvent?        @relation(fields: [accountingEventId], references: [id])
  @@index([companyId, taxPeriod, direction, status])
  @@index([sourceType, sourceId])
  @@index([taxCodeId, transactionDate])
}

model TaxDocument {
  id               String   @id @default(uuid())
  companyId        String
  branchId         String?
  number           String
  documentType     String
  status           String   @default("DRAFT")
  sourceType       String
  sourceId         String
  issueDate        DateTime @default(now())
  taxPeriod        String?
  counterpartyName String?
  counterpartyTaxId String?
  netAmount        Decimal  @default(0)
  taxAmount        Decimal  @default(0)
  grossAmount      Decimal  @default(0)
  externalReference String?
  fileReference    String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([companyId, number])
  @@index([companyId, taxPeriod, status])
  @@index([sourceType, sourceId])
}

model AccountingCloseControl {
  id              String   @id @default(uuid())
  companyId       String
  branchId        String?
  module          String
  periodStart     DateTime
  periodEnd       DateTime
  status          String   @default("OPEN")
  closedById      String?
  closedAt        DateTime?
  reopenReason    String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([companyId, branchId, module, periodStart, periodEnd])
  @@index([companyId, status, periodEnd])
}

model AssetCategory {
  id                          String    @id @default(uuid())
  companyId                   String
  code                        String
  name                        String
  assetType                   AssetType
  depreciationMethod          String    @default("STRAIGHT_LINE")
  usefulLifeMonths            Int?
  residualValuePercent        Decimal   @default(0)
  assetAccountCode            String?
  accumulatedDepreciationCode String?
  depreciationExpenseCode     String?
  maintenanceExpenseCode      String?
  defaultInspectionTemplateId String?
  metadata                    Json?
  isActive                    Boolean   @default(true)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  @@unique([companyId, code])
  @@index([companyId, assetType, isActive])
}

model Asset {
  id                    String      @id @default(uuid())
  companyId             String
  branchId              String?
  warehouseId           String?
  categoryId            String
  parentAssetId         String?
  code                  String
  name                  String
  assetType             AssetType
  status                AssetStatus @default(DRAFT)
  serialNumber          String?
  registrationNumber    String?
  acquisitionDate       DateTime?
  capitalizationDate    DateTime?
