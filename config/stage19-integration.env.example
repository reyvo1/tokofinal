# Salin menjadi stage19-integration.env. Jangan commit credential.
T360_STAGE19_TARGET=STAGING
T360_STAGE19_CONFIRM=RUN_T360_STAGE19_NON_PRODUCTION
T360_STAGE19_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/toko360_staging?sslmode=disable
T360_STAGE19_EXPECTED_HOST=localhost
T360_STAGE19_EXPECTED_DATABASE=toko360_staging

# Port sementara untuk API integration; jangan gunakan port aplikasi utama.
T360_STAGE19_API_PORT=41919
T360_STAGE19_API_START_TIMEOUT_MS=60000
