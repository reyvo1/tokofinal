# Salin menjadi stage20-release-readiness.env. Jangan commit credential.
T360_STAGE20_TARGET=STAGING
T360_STAGE20_CONFIRM=RUN_T360_STAGE20_NON_PRODUCTION
T360_STAGE20_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/toko360_staging?sslmode=disable
T360_STAGE20_EXPECTED_HOST=localhost
T360_STAGE20_EXPECTED_DATABASE=toko360_staging

# Port sementara untuk health observation.
T360_STAGE20_API_PORT=42020
T360_STAGE20_API_START_TIMEOUT_MS=60000
T360_STAGE20_OBSERVATION_SAMPLES=30
T360_STAGE20_OBSERVATION_INTERVAL_MS=1000
T360_STAGE20_HEALTH_P95_BUDGET_MS=1000
T360_STAGE20_LONG_QUERY_THRESHOLD_MS=15000
T360_STAGE20_MAX_ACTIVE_CONNECTIONS=50
