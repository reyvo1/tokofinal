# Salin menjadi stage18-postgres.env. Jangan commit file berisi credential.
T360_STAGE18_TARGET=STAGING
T360_STAGE18_CONFIRM=APPLY_T360_STAGE18_NON_PRODUCTION

# Target TEST/STAGING yang akan menerima expand/backfill.
T360_STAGE18_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/toko360_staging?sslmode=require
T360_STAGE18_EXPECTED_HOST=HOST
T360_STAGE18_EXPECTED_DATABASE=toko360_staging

# Database scratch KHUSUS restore drill. Isinya akan diganti oleh script.
T360_STAGE18_RESTORE_CONFIRM=REPLACE_T360_STAGE18_RESTORE_DATABASE
T360_STAGE18_RESTORE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/toko360_stage18_restore?sslmode=require
T360_STAGE18_EXPECTED_RESTORE_HOST=HOST
T360_STAGE18_EXPECTED_RESTORE_DATABASE=toko360_stage18_restore

T360_STAGE18_DECISIONS_FILE=stage18-ownership-decisions.json
# Opsional bila executable PostgreSQL tidak ada di PATH:
# T360_STAGE18_PSQL=C:\Program Files\PostgreSQL\17\bin\psql.exe
# T360_STAGE18_PG_DUMP=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# T360_STAGE18_PG_RESTORE=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
