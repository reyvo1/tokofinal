# Toko360 PostgreSQL profile — staging/production. Copy to a protected environment file and replace every CHANGE_ME value.
NODE_ENV=staging
DATABASE_PROFILE=postgresql
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DB?schema=public

API_PORT=4000
# Required on staging/production: unique secret >= 32 chars. Leave blank until injected securely.
JWT_SECRET=
# Public-order token secret. Prefer a different >=32-char secret from JWT_SECRET.
ORDER_ACCESS_SECRET=
ALLOW_MOCK_PAYMENTS=false
NEXT_PUBLIC_BRANCH_CODE=PUSAT
JWT_EXPIRES_IN=15m
# Database-backed login throttling shared across API instances.
AUTH_EMAIL_FAIL_LIMIT=5
AUTH_EMAIL_WINDOW_MS=900000
AUTH_EMAIL_BLOCK_MS=900000
AUTH_IP_FAIL_LIMIT=30
AUTH_IP_WINDOW_MS=900000
AUTH_IP_BLOCK_MS=900000

# PostgreSQL defaults to bootstrap seed (no demo products/supplier/cashier/employee).
SEED_MODE=bootstrap
SEED_COMPANY_ID=CHANGE_ME_UUID
SEED_COMPANY_NAME=CHANGE_ME_COMPANY
SEED_COMPANY_SLUG=change-me-company
SEED_BRANCH_CODE=PUSAT
SEED_BRANCH_NAME=Cabang Pusat
SEED_BRANCH_ADDRESS=
SEED_WAREHOUSE_CODE=GDG-UTAMA
SEED_WAREHOUSE_NAME=Gudang Utama
SEED_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
SEED_ADMIN_PASSWORD=
# Required on staging/production. Set explicit browser origins; wildcard is rejected.
CORS_ORIGINS=
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Offline POS: umur maksimum cache harga/pajak untuk transaksi tunai offline.
POS_OFFLINE_MAX_CACHE_MINUTES=1440

# Optional production queue/provider configuration.
REDIS_URL=redis://localhost:6379
# Secret-at-rest key: exactly 32 bytes encoded as 64 hex chars or base64.
# In production inject this from your secret manager/KMS bootstrap, never commit the real key.
SECRET_MASTER_KEY=
SECRET_KEY_ID=env-v1
# Legacy alias is still accepted temporarily; prefer SECRET_MASTER_KEY.
ENCRYPTION_KEY=
APP_VERSION=0.5.3
WORKER_INTERVAL_MS=5000
# Required before webhook delivery is enabled on staging/production; unique >= 32 chars.
WEBHOOK_SIGNING_SECRET=

# HRIS / employee portal
EMPLOYEE_PORTAL_URL=http://localhost:3003
ATTENDANCE_PHOTO_RETENTION_DAYS=180
ATTENDANCE_MEDIA_PROVIDER=disabled

# Payslip notifications. Leave blank until provider credentials are configured.
TELEGRAM_BOT_TOKEN=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=

JWT_REFRESH_EXPIRES_DAYS=30
AUTH_PASSWORD_RESET_EXPIRES_MINUTES=30
AUTH_EXPOSE_RESET_TOKEN=false
ADMIN_PUBLIC_URL=http://localhost:3001

# Storefront customer account
CUSTOMER_SESSION_TTL_HOURS=720
CUSTOMER_VERIFICATION_DEBUG_CODE=false
