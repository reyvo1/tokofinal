# Toko360 local profile — no Docker / no virtual machine required.
DATABASE_PROFILE=sqlite
DATABASE_URL=file:./data/toko360.db

# API
API_PORT=4000
JWT_SECRET=ganti-dengan-rahasia-yang-panjang-minimal-32-karakter
ORDER_ACCESS_SECRET=ganti-dengan-rahasia-order-yang-panjang-minimal-32-karakter
ALLOW_MOCK_PAYMENTS=false
NEXT_PUBLIC_BRANCH_CODE=PUSAT
CUSTOMER_SESSION_TTL_HOURS=720
CUSTOMER_VERIFICATION_DEBUG_CODE=true
JWT_EXPIRES_IN=15m
# Database-backed login throttling shared across API instances.
AUTH_EMAIL_FAIL_LIMIT=5
AUTH_EMAIL_WINDOW_MS=900000
AUTH_EMAIL_BLOCK_MS=900000
AUTH_IP_FAIL_LIMIT=30
AUTH_IP_WINDOW_MS=900000
AUTH_IP_BLOCK_MS=900000

# Local/demo seed. PostgreSQL and staging/production default to bootstrap mode instead.
SEED_MODE=demo
SEED_ADMIN_PASSWORD=Admin123!
SEED_CASHIER_PASSWORD=Kasir123!
SEED_EMPLOYEE_PASSWORD=Employee123!
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Offline POS: umur maksimum cache harga/pajak untuk transaksi tunai offline.
POS_OFFLINE_MAX_CACHE_MINUTES=1440

# Worker / integrations. Redis is optional and not needed for local MVP.
# Secret-at-rest key: exactly 32 bytes encoded as 64 hex chars or base64.
# In production inject this from your secret manager/KMS bootstrap, never commit the real key.
SECRET_MASTER_KEY=
SECRET_KEY_ID=env-v1
# Legacy alias is still accepted temporarily; prefer SECRET_MASTER_KEY.
ENCRYPTION_KEY=
APP_VERSION=0.5.3
WORKER_INTERVAL_MS=5000
WEBHOOK_SIGNING_SECRET=ganti-dengan-rahasia-webhook

# HRIS / employee portal
EMPLOYEE_PORTAL_URL=http://localhost:3003
ATTENDANCE_PHOTO_RETENTION_DAYS=180
ATTENDANCE_MEDIA_PROVIDER=local

# Payslip notifications. Leave blank until provider credentials are configured.
TELEGRAM_BOT_TOKEN=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=

JWT_REFRESH_EXPIRES_DAYS=30
AUTH_PASSWORD_RESET_EXPIRES_MINUTES=30
AUTH_EXPOSE_RESET_TOKEN=true
ADMIN_PUBLIC_URL=http://localhost:3001
